# Configure os três checkouts com os produtos e preços correspondentes.
NEXT_PUBLIC_CHECKOUT_BASIC_URL=
NEXT_PUBLIC_CHECKOUT_FULL_URL=
NEXT_PUBLIC_CHECKOUT_UPGRADE_URL=

# A condição de upgrade expira após este período por navegador.
# O checkout de upgrade também deve fazer cumprir esse prazo.
NEXT_PUBLIC_UPGRADE_WINDOW_MINUTES=120

# URL opcional de um JSON com compras reais autorizadas.
# Em desenvolvimento, sem esta URL, há notificações de demonstração identificadas.
NEXT_PUBLIC_PURCHASE_FEED_URL=

# Rastreamento opcional. Confira os IDs da conta antes de ativar.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_UTMIFY_ENABLED=false
